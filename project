import tkinter as tk
from tkinter import messagebox

# --- 2. CALCULATOR WINDOW FUNCTION ---
def open_planner_window():
    # Create a secondary (Toplevel) window
    planner_win = tk.Toplevel(root)
    planner_win.title("Schedule Calculator")
    planner_win.geometry("350x250")
    
    # Text labels and text boxes for user input
    tk.Label(planner_win, text="Total Book Pages:", font=("Arial", 11)).pack(pady=5)
    pages_entry = tk.Entry(planner_win, font=("Arial", 11))
    pages_entry.pack(pady=5)
    
    tk.Label(planner_win, text="Pages to Read Per Day:", font=("Arial", 11)).pack(pady=5)
    target_entry = tk.Entry(planner_win, font=("Arial", 11))
    target_entry.pack(pady=5)
    
    # Label where the mathematical result will be shown
    result_label = tk.Label(planner_win, text="", font=("Arial", 11, "bold"), fg="blue")
    result_label.pack(pady=15)

    # --- 3. NESTED CALCULATION FUNCTION ---
    def calculate_schedule():
        try:
            # Grab raw text inputs and convert them into whole numbers
            total_pages = int(pages_entry.get())
            pages_per_day = int(target_entry.get())
            
            # Simple validation: Prevent crash from dividing by zero or negative values
            if total_pages <= 0 or pages_per_day <= 0:
                messagebox.showerror("Error", "Please enter positive numbers greater than 0.")
                return
            
            # Perform math calculations using floor division (//) and modulo (%)
            full_days = total_pages // pages_per_day
            leftover_pages = total_pages % pages_per_day
            
            # Display results based on whether there are leftover pages
            if leftover_pages == 0:
                result_label.config(text=f"It will take exactly {full_days} days!")
            else:
                result_label.config(
                    text=f"It will take {full_days} full days,\nplus 1 extra day for the remaining {leftover_pages} pages."
                )
                
        except ValueError:
            # Pop up a warning box if users type letters instead of numbers
            messagebox.showerror("Invalid Input", "Please type whole numbers only!")

    # Button inside the pop-up window that triggers the nested math function
    tk.Button(planner_win, text="Calculate Plan", command=calculate_schedule, bg="green", fg="white").pack(pady=5)

# --- 1. MAIN APPLICATON WINDOW ---
root = tk.Tk()
root.title("Reading Schedule Planner")
root.geometry("400x200")

# Welcome Labels inside the main window
tk.Label(root, text="Welcome to the Reading Schedule Planner!", font=("Arial", 14, "bold")).pack(pady=20)
tk.Label(root, text="Plan your reading goals effortlessly.", font=("Arial", 11)).pack(pady=5)

# Button on main screen that launches the secondary calculator window
start_button = tk.Button(root, text="Open Planner", font=("Arial", 11), command=open_planner_window, bg="blue", fg="white")
start_button.pack(pady=20)

# Keep the window running on your screen
root.mainloop()
